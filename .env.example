# ─────────────────────────────────────────────────────────────
#  Which brain?  "anthropic" (Claude) or "openai" (ChatGPT)
#  Leave BRAIN_PROVIDER unset and it auto-picks whichever key exists.
# ─────────────────────────────────────────────────────────────
BRAIN_PROVIDER=anthropic

# --- Claude (console.anthropic.com) ---
ANTHROPIC_API_KEY=sk-ant-...
# Any current model id. Opus 5 is the default and the most capable.
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max  — how hard it thinks per turn
ANTHROPIC_EFFORT=high

# --- ChatGPT (platform.openai.com) ---
# Also used for embeddings + high-quality voice even when Claude is the brain.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# --- Server ---
PORT=8787
# Where the brain keeps its memories (JSON, auto-created)
DATA_DIR=./data

# Name it. It'll answer to this.
BRAIN_NAME=Atlas
