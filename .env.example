# ─────────────────────────────────────────────────────────────
#  Which brain?
#    claude-code  → your Claude Pro/Max SUBSCRIPTION, via the locally
#                   logged-in Claude Code. No API key, no metered billing.
#                   Run `claude` once to sign in first.
#    anthropic    → Anthropic API key (billed per token, separate from Max)
#    openai       → OpenAI API key (billed per token, separate from Plus)
#
#  Neither a Claude Max plan nor ChatGPT Plus includes API access — they are
#  separate products. To use those subscriptions instead, see
#  docs/SUBSCRIPTIONS.md. Unset here, it auto-picks whichever key exists.
# ─────────────────────────────────────────────────────────────
BRAIN_PROVIDER=anthropic

# --- Claude subscription route (BRAIN_PROVIDER=claude-code) ---
# All optional; empty means "whatever Claude Code is already set to".
CLAUDE_CODE_MODEL=
CLAUDE_CODE_EFFORT=
CLAUDE_CODE_MAX_TURNS=16

# --- Claude (console.anthropic.com) ---
ANTHROPIC_API_KEY=sk-ant-...
# Any current model id. Opus 5 is the default and the most capable.
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max  — how hard it thinks per turn
ANTHROPIC_EFFORT=high

# --- ChatGPT (platform.openai.com) ---
# Also used for embeddings + high-quality voice even when Claude is the brain.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# --- Server ---
PORT=8787
# Where the brain keeps its memories (JSON, auto-created)
DATA_DIR=./data

# Name it. It'll answer to this.
BRAIN_NAME=Atlas

# --- MCP server (lets Claude Desktop / ChatGPT drive the graph) ---
# Where the MCP server finds this app.
BRAIN_APP_URL=http://127.0.0.1:8787
# Port for the HTTP transport that ChatGPT connectors need.
MCP_PORT=8788
